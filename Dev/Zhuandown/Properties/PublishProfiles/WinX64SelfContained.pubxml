<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win10-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 发布包使用 Release CRT，避免旧依赖按项目引用自动探测调试配置。 -->
    <VCRTForwarders-IncludeDebugCRT>false</VCRTForwarders-IncludeDebugCRT>
    <PublishProtocol>FileSystem</PublishProtocol>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\Zhuandown-win-x64\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>
</Project>
